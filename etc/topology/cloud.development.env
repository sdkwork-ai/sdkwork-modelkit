# cloud.development
SDKWORK_MODELKIT_DEPLOYMENT_PROFILE=cloud
SDKWORK_MODELKIT_ENVIRONMENT=development
SDKWORK_MODELKIT_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MODELKIT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MODELKIT_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3901
SDKWORK_MODELKIT_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_MODELKIT_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

VITE_SDKWORK_MODELKIT_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_MODELKIT_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MODELKIT_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3901


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://modelkit-dev.sdkwork.com,http://modelkit-dev.sdkwork.com,https://modelkit-dev.birdcoder.com,http://modelkit-dev.birdcoder.com,https://modelkit-dev.dtupay.com,http://modelkit-dev.dtupay.com,https://modelkit-dev.noaper.com,http://modelkit-dev.noaper.com,https://modelkit-dev.sdkwork.cn,http://modelkit-dev.sdkwork.cn,https://modelkit-dev.birdcoder.cn,http://modelkit-dev.birdcoder.cn,https://modelkit-dev.dtupay.cn,http://modelkit-dev.dtupay.cn,https://modelkit-dev.noaper.cn,http://modelkit-dev.noaper.cn,https://modelkit-dev.skubc.com,http://modelkit-dev.skubc.com,https://modelkit-dev.skubc.cn,http://modelkit-dev.skubc.cn,https://modelkit-dev.zowalk.com,http://modelkit-dev.zowalk.com,https://modelkit-dev.zowalk.cn,http://modelkit-dev.zowalk.cn,https://modelkit-dev.offer86.com,http://modelkit-dev.offer86.com,https://modelkit-dev.offer86.cn,http://modelkit-dev.offer86.cn,https://modelkit-dev.86offer.com,http://modelkit-dev.86offer.com,https://modelkit-dev.86offer.cn,http://modelkit-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
