    "development": {
      "applicationOrigin": "http://127.0.0.1:3901/",
      "cloudApiBaseUrl": "https://api-dev.sdkwork.com/"
    },
    "test": {
      "applicationOrigin": "https://modelkit-test.sdkwork.com/",
      "cloudApiBaseUrl": "https://api-test.sdkwork.com/"
    },
    "staging": {
      "applicationOrigin": "https://modelkit-staging.sdkwork.com/",
      "cloudApiBaseUrl": "https://api-staging.sdkwork.com/"
    },
    "production": {
      "applicationOrigin": "https://modelkit.sdkwork.com/",
      "cloudApiBaseUrl": "https://api.sdkwork.com/"
    },
    "demo": {
      "applicationOrigin": "https://modelkit-demo.sdkwork.com/",
      "cloudApiBaseUrl": "https://api-demo.sdkwork.com;https://api-demo.birdcoder.com;https://api-demo.dtupay.com;https://api-demo.sdkwork.cn;https://api-demo.birdcoder.cn;https://api-demo.dtupay.cn;https://api-demo.skubc.com;https://api-demo.skubc.cn;https://api-demo.zowalk.com;https://api-demo.zowalk.cn;https://api-demo.offer86.com;https://api-demo.offer86.cn;https://api-demo.86offer.com;https://api-demo.86offer.cn"
    }
  },
  "profiles": {
