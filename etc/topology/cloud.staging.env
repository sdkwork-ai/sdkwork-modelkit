# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_MODELKIT_DEPLOYMENT_PROFILE=cloud
SDKWORK_MODELKIT_ENVIRONMENT=staging
SDKWORK_MODELKIT_PROFILE_ID=cloud.staging
SDKWORK_MODELKIT_APPLICATION_PUBLIC_HTTP_URL=https://modelkit-staging.sdkwork.com
SDKWORK_MODELKIT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MODELKIT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

