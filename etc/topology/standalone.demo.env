# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema/database `sdkwork_modelkit_demo`
# and a dedicated Redis logical DB index / `modelkit-demo` key prefix so that no cache key
# (rate-limit, session, idempotency) ever collides with another shared-redis environment.
SDKWORK_MODELKIT_DEPLOYMENT_PROFILE=standalone
SDKWORK_MODELKIT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_MODELKIT_PROFILE_ID=standalone.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MODELKIT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 3901) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_MODELKIT_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3909
SDKWORK_MODELKIT_APPLICATION_PUBLIC_HTTP_URL=https://modelkit-demo.sdkwork.com

VITE_SDKWORK_MODELKIT_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_MODELKIT_APPLICATION_PUBLIC_HTTP_URL=https://modelkit-demo.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api-demo.sdkwork.com

# Redis isolation: modelkit declares no concrete redis env keys in these profiles; provisioning
# must assign a dedicated logical DB index / `modelkit-demo` prefix on the shared Redis so cache,
# rate-limit, and idempotency keys stay confined to this environment.
SDKWORK_CORS_ALLOWED_ORIGINS=https://modelkit-demo.sdkwork.com,http://modelkit-demo.sdkwork.com,https://modelkit-demo.birdcoder.com,http://modelkit-demo.birdcoder.com,https://modelkit-demo.dtupay.com,http://modelkit-demo.dtupay.com,https://modelkit-demo.noaper.com,http://modelkit-demo.noaper.com,https://modelkit-demo.sdkwork.cn,http://modelkit-demo.sdkwork.cn,https://modelkit-demo.birdcoder.cn,http://modelkit-demo.birdcoder.cn,https://modelkit-demo.dtupay.cn,http://modelkit-demo.dtupay.cn,https://modelkit-demo.noaper.cn,http://modelkit-demo.noaper.cn,https://modelkit-demo.skubc.com,http://modelkit-demo.skubc.com,https://modelkit-demo.skubc.cn,http://modelkit-demo.skubc.cn,https://modelkit-demo.zowalk.com,http://modelkit-demo.zowalk.com,https://modelkit-demo.zowalk.cn,http://modelkit-demo.zowalk.cn,https://modelkit-demo.offer86.com,http://modelkit-demo.offer86.com,https://modelkit-demo.offer86.cn,http://modelkit-demo.offer86.cn,https://modelkit-demo.86offer.com,http://modelkit-demo.86offer.com,https://modelkit-demo.86offer.cn,http://modelkit-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
